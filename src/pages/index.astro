---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Accueil"
  metaTitle="Berlioz Conseil — Conseil patrimonial privé en Rhône-Alpes"
  description="Berlioz Conseil accompagne particuliers, dirigeants et professions libérales dans la structuration, la protection et la transmission de leur patrimoine."
>
  <main class="min-h-svh flex items-center justify-center premium-gradient bg-visual bg-hero-landing-a bg-visual-entry relative px-5 py-10">
    <div class="entry-content max-w-2xl text-center flex flex-col items-center">
      <div class="mb-6">
        <img
          src={withBase('/logo/berlioz-logo-round.webp')}
          alt=""
          class="mx-auto h-46 w-46 md:h-56 md:w-56 berlioz-round-logo"
          width="1024"
          height="1024"
          loading="eager"
          decoding="async"
        />
        <h1 class="sr-only">Berlioz Conseil</h1>
      </div>

      <p class="text-bc-text-secondary text-base md:text-lg mb-8 max-w-xl mx-auto leading-relaxed entrance-up entrance-delay-1">
        Conseil patrimonial privé en Rhône-Alpes. Une approche confidentielle pour structurer, protéger et transmettre ce qui engage l'avenir familial, professionnel et patrimonial.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center w-full max-w-lg entrance-up entrance-delay-2">
        <Button href={withBase('/accueil')} variant="primary" class="w-full">
          Découvrir le cabinet
        </Button>
        <Button href={withBase('/acces-client')} variant="outline" class="w-full">
          Accès client
        </Button>
      </div>
      <nav aria-label="Informations légales" class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-bc-text-muted">
        <a class="underline underline-offset-4 hover:text-bc-text-primary" href={withBase('/mentions-legales')}>Mentions légales</a>
        <a class="underline underline-offset-4 hover:text-bc-text-primary" href={withBase('/confidentialite')}>Confidentialité</a>
      </nav>
    </div>
  </main>
</BaseLayout>
