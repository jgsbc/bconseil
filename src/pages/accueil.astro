---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { withBase } from '../lib/paths';

const situations = [
  {
    title: "Structurer une épargne devenue dispersée",
    text: "Remettre en cohérence liquidités, assurance-vie, comptes-titres et autres supports d'investissement autour d'une ligne claire.",
  },
  {
    title: "Arbitrer entre immobilier, assurance-vie et investissements financiers",
    text: "Comparer les options avec une lecture patrimoniale d'ensemble, sans survente d'un support ou d'un produit.",
  },
  {
    title: "Préparer la retraite et les revenus futurs",
    text: "Anticiper les ressources de demain pour sécuriser les choix à venir, avant qu'ils ne deviennent contraints.",
  },
  {
    title: "Protéger le conjoint, les enfants ou le dirigeant",
    text: "Travailler la prévoyance et l'assurance de personnes dans une logique familiale et professionnelle.",
  },
  {
    title: "Organiser la transmission",
    text: "Préparer une transmission familiale ou professionnelle avec une lecture successorale plus lisible.",
  },
  {
    title: "Clarifier la fiscalité patrimoniale",
    text: "Mettre les choix patrimoniaux en cohérence avec le cadre fiscal applicable, sans promesse de réduction garantie.",
  },
];

const dimensions = [
  {
    title: "Financière",
    text: "Lecture des supports, du niveau de risque, de l'allocation et de la cohérence globale.",
  },
  {
    title: "Fiscale",
    text: "Anticipation des effets fiscaux, lecture prudente et cohérente des décisions patrimoniales.",
  },
  {
    title: "Juridique",
    text: "Décisions à articuler avec les conseils du client lorsque la situation l'exige.",
  },
  {
    title: "Successorale",
    text: "Préparer les effets de la transmission et éviter les angles morts dans le temps.",
  },
  {
    title: "Familiale",
    text: "Protéger le conjoint, les enfants et l'équilibre de vie autour du patrimoine.",
  },
  {
    title: "Professionnelle",
    text: "Articuler patrimoine privé, activité, rémunération, trésorerie et protection du dirigeant.",
  },
];

const methodSteps = [
  {
    number: "1",
    title: "Premier rendez-vous",
    text: "Comprendre les enjeux, le contexte familial et professionnel, et les priorités immédiates.",
  },
  {
    number: "2",
    title: "Audit patrimonial",
    text: "Analyser l'existant, les supports détenus et les points de cohérence à renforcer.",
  },
  {
    number: "3",
    title: "Diagnostic et stratégie patrimoniale",
    text: "Formuler des scénarios lisibles et hiérarchiser les arbitrages utiles.",
  },
  {
    number: "4",
    title: "Mise en place des solutions",
    text: "Déployer les actions retenues avec un suivi rigoureux des étapes utiles.",
  },
  {
    number: "5",
    title: "Suivi annuel et ajustements",
    text: "Revoir les choix à mesure que la situation personnelle, professionnelle ou fiscale évolue.",
  },
];
---

<BaseLayout
  title="Accueil"
  metaTitle="Berlioz Conseil — Conseil patrimonial en Rhône-Alpes"
  description="Berlioz Conseil accompagne particuliers, dirigeants et professions libérales dans l’organisation, la protection et la transmission de leur patrimoine."
>
  <Header />
  <main class="flex-grow">
    <Section class="bg-visual bg-inner-a bg-visual-readable premium-gradient min-h-[70vh] flex items-center border-b border-bc-border">
      <Container>
        <Eyebrow>Conseil patrimonial privé</Eyebrow>
        <h1 class="max-w-4xl text-4xl md:text-6xl lg:text-7xl mb-8 leading-tight">
          Conseil patrimonial en Rhône-Alpes pour les décisions qui engagent l'avenir
        </h1>
        <p class="max-w-3xl text-xl text-bc-text-secondary mb-8">
          Berlioz Conseil accompagne des clients dont les décisions patrimoniales engagent des enjeux financiers, familiaux, professionnels ou successoraux significatifs.
        </p>
        <p class="max-w-3xl text-lg text-bc-text-muted mb-12">
          Particuliers, dirigeants, professions libérales, familles, retraités, cadres supérieurs et entrepreneurs trouvent ici un accompagnement sobre, confidentiel et lisible.
        </p>
        <div class="flex flex-wrap gap-6">
          <Button href={withBase('/contact')} variant="primary">Demander un premier échange patrimonial</Button>
          <Button href={withBase('/expertises')} variant="outline">Explorer les expertises</Button>
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <Eyebrow>Pour quels enjeux ?</Eyebrow>
        <h2 class="mb-6">Structurer, protéger et transmettre</h2>
        <p class="max-w-3xl text-bc-text-secondary mb-12">
          Le cabinet intervient auprès de clients qui souhaitent structurer un patrimoine déjà constitué ou en phase de développement, avec une attention particulière portée à la cohérence d'ensemble, à la protection et à la transmission.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {situations.map((item) => (
            <Card class="premium-card-motion h-full">
              <h3 class="text-bc-text-primary text-xl font-serif mb-4">{item.title}</h3>
              <p class="text-bc-text-secondary text-sm mb-0">{item.text}</p>
            </Card>
          ))}
        </div>
      </Container>
    </Section>

    <Section bg="secondary" class="bg-visual bg-structured-a bg-visual-soft border-y border-bc-border">
      <Container>
        <Eyebrow>Une approche globale</Eyebrow>
        <h2 class="mb-6">Lire la situation dans son ensemble</h2>
        <p class="max-w-3xl text-bc-text-secondary mb-12">
          Une décision patrimoniale se comprend rarement dans un seul angle. Lorsque la situation l'exige, l'accompagnement peut s'articuler avec les autres conseils du client.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {dimensions.map((item) => (
            <Card class="premium-card-motion h-full">
              <h3 class="text-bc-accent-champagne text-xl font-serif mb-3">{item.title}</h3>
              <p class="text-bc-text-secondary text-sm mb-0">{item.text}</p>
            </Card>
          ))}
        </div>
      </Container>
    </Section>

    <Section>
      <Container>
        <Eyebrow>Méthode</Eyebrow>
        <h2 class="mb-6">Méthode en 5 étapes</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-6">
          {methodSteps.map((step) => (
            <Card class="premium-card-motion h-full">
              <p class="text-bc-accent-bronze text-sm tracking-[0.3em] uppercase mb-4">Étape {step.number}</p>
              <h3 class="text-bc-text-primary text-xl font-serif mb-4">{step.title}</h3>
              <p class="text-bc-text-secondary text-sm mb-0">{step.text}</p>
            </Card>
          ))}
        </div>
      </Container>
    </Section>

    <Section bg="secondary" class="border-y border-bc-border">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 items-start">
          <div>
            <Eyebrow>Cabinet à taille humaine</Eyebrow>
            <h2 class="mb-6">Une relation directe, claire et durable</h2>
            <p class="text-bc-text-secondary mb-6">
              Berlioz Conseil privilégie la confidentialité, la pédagogie et la clarté des décisions. L'objectif n'est pas d'accumuler des solutions, mais de construire un accompagnement lisible et cohérent dans le temps.
            </p>
            <p class="text-bc-text-secondary mb-0">
              Le cabinet intervient avec une attention particulière portée à l'équilibre entre patrimoine privé et professionnel, à la protection de la famille et à la préparation des étapes qui engagent l'avenir.
            </p>
          </div>

          <Card class="premium-card-motion">
            <h3 class="text-bc-text-primary text-xl font-serif mb-6">Ce que vous pouvez attendre</h3>
            <ul class="space-y-4 text-bc-text-secondary text-sm">
              <li class="flex gap-3"><span class="text-bc-accent-bronze mt-1">▪</span> Une relation directe avec le cabinet</li>
              <li class="flex gap-3"><span class="text-bc-accent-bronze mt-1">▪</span> Une lecture cohérente de votre situation</li>
              <li class="flex gap-3"><span class="text-bc-accent-bronze mt-1">▪</span> Une pédagogie simple et rigoureuse</li>
              <li class="flex gap-3"><span class="text-bc-accent-bronze mt-1">▪</span> Un accompagnement dans la durée</li>
              <li class="flex gap-3"><span class="text-bc-accent-bronze mt-1">▪</span> Une articulation possible avec les autres conseils du client</li>
            </ul>
          </Card>
        </div>
      </Container>
    </Section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
