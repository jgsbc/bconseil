---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Card from '../components/Card.astro';
import CTASection from '../components/CTASection.astro';

const expertises = [
  {
    title: "Structurer l'épargne et les investissements",
    bullets: [
      "Assurance-vie",
      "Allocation patrimoniale",
      "Investissements financiers",
      "Cohérence globale",
      "Diversification sans promesse",
    ],
  },
  {
    title: "Préparer la retraite",
    bullets: [
      "Revenus futurs",
      "Équilibre entre capital, revenus et protection",
      "Anticipation des étapes de vie",
    ],
  },
  {
    title: "Protéger la famille et le dirigeant",
    bullets: [
      "Prévoyance",
      "Assurance de personnes",
      "Conjoint",
      "Enfants",
      "Continuité de l'activité",
    ],
  },
  {
    title: "Organiser la transmission",
    bullets: [
      "Transmission familiale",
      "Anticipation successorale",
      "Fiscalité patrimoniale",
      "Articulation possible avec notaire ou avocat",
    ],
  },
  {
    title: "Accompagner le dirigeant et la profession libérale",
    bullets: [
      "Rémunération",
      "Patrimoine privé et professionnel",
      "Trésorerie",
      "Protection",
      "Cession ou transmission",
    ],
  },
  {
    title: "Immobilier et financement dans une logique patrimoniale",
    bullets: [
      "Cohérence de l'immobilier dans le patrimoine",
      "Arbitrage",
      "Financement",
      "Vision de long terme",
    ],
  },
  {
    title: "Fiscalité patrimoniale",
    bullets: [
      "Lecture fiscale",
      "Anticipation",
      "Cohérence",
      "Aucune promesse de réduction fiscale garantie",
    ],
  },
];
---

<BaseLayout
  title="Expertises"
  metaTitle="Expertises — Gestion de patrimoine, épargne et transmission"
  description="Épargne, investissements financiers, retraite, prévoyance, transmission et accompagnement patrimonial du dirigeant en Rhône-Alpes."
>
  <Header />
  <main class="flex-grow">
    <PageHero
      title="Expertises patrimoniales"
      description="Épargne, investissements financiers, retraite, prévoyance, transmission : Berlioz Conseil aide à mettre en cohérence les décisions qui engagent le patrimoine familial et professionnel."
      bgClass="bg-visual bg-structured-a bg-visual-readable"
    />

    <Section>
      <Container>
        <p class="max-w-3xl text-bc-text-secondary mb-12">
          Le cabinet accompagne des clients en Rhône-Alpes qui souhaitent structurer un patrimoine déjà constitué ou en phase de développement, avec une attention particulière portée à la cohérence d'ensemble, à la protection et à la transmission.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {expertises.map((item) => (
            <Card class="premium-card-motion h-full">
              <h3 class="text-bc-accent-champagne text-2xl font-serif mb-6">{item.title}</h3>
              <ul class="space-y-3 text-bc-text-secondary text-sm">
                {item.bullets.map((bullet) => (
                  <li class="flex gap-3">
                    <span class="text-bc-accent-bronze mt-1">▪</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </Card>
          ))}
        </div>
      </Container>
    </Section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
