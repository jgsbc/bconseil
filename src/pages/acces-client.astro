---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Accès client"
  metaTitle="Accès client — Berlioz Conseil"
  description="Accédez à votre espace client via l’environnement professionnel externe utilisé par Berlioz Conseil."
>
  <Header />
  <main class="flex-grow premium-gradient flex flex-col justify-center bg-visual bg-inner-b bg-visual-readable">
    <Section class="text-center">
      <Container class="max-w-2xl">
        <h1 class="mb-6 font-serif">Accès client</h1>
        <p class="mb-12 text-bc-text-secondary text-lg">
          L'espace client est opéré via les outils professionnels utilisés par Berlioz Conseil. Vous serez redirigé vers un environnement externe sécurisé.
        </p>

        <Card class="inline-block p-12 max-w-xl mx-auto text-left">
          <p class="text-bc-text-secondary mb-8">
            Vous accédez ici à l'environnement externe mis à disposition pour consulter vos documents et les informations liées à votre accompagnement.
            <br /><br />
            Le cabinet ne vous demandera jamais de transmettre d'informations sensibles par un canal non sécurisé.
          </p>
          <div class="border-t border-bc-border pt-8 mt-8">
            <Button href="https://connect.harvest.fr/accueil" target="_blank" rel="noopener noreferrer" variant="primary" class="w-full">
              Accéder à mon espace client
            </Button>
            <p class="text-xs text-bc-text-muted mt-4 text-center italic">
              Vous allez être redirigé vers un environnement externe sécurisé.
            </p>
          </div>
        </Card>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
