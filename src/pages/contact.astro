---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import LegalNoticeBlock from '../components/LegalNoticeBlock.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contact"
  metaTitle="Contact — Demander un premier échange patrimonial"
  description="Contactez Berlioz Conseil pour organiser un premier échange patrimonial confidentiel en Rhône-Alpes."
>
  <Header />
  <main class="flex-grow">
    <PageHero
      title="Parlons de votre projet patrimonial"
      description="Présentez votre besoin pour organiser un premier échange avec Aurélien Picard."
      bgClass="bg-visual bg-inner-b bg-visual-readable"
    />

    <Section>
      <Container class="max-w-5xl">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="order-1 lg:order-2 lg:col-span-2 surface-depth p-5 md:p-6">
            <h2 class="text-2xl font-serif text-bc-text-primary mb-3">Formulaire de contact</h2>
            <p class="text-bc-text-muted mb-5 text-sm leading-relaxed">
              Ne transmettez aucun identifiant, document confidentiel ou détail de votre patrimoine. Aucun conseil personnalisé n'est délivré via ce formulaire. Les champs marqués * sont obligatoires.
            </p>
            <ContactForm />
          </div>

          <div class="order-2 lg:order-1 lg:col-span-1 space-y-6">
            <div>
              <LegalNoticeBlock title="Coordonnées">
                <p>Email : <a href="mailto:contact@berliozconseil.fr" class="underline underline-offset-4">contact@berliozconseil.fr</a></p>
                <p>Téléphone : <a href="tel:+33603071011" class="underline underline-offset-4">06 03 07 10 11</a></p>
              </LegalNoticeBlock>
            </div>

            <div>
              <LegalNoticeBlock title="Adresse">
                <p>6 rue de la Pelonniere<br />69660 Collonges-au-Mont-d'Or</p>
              </LegalNoticeBlock>
            </div>

          </div>

        </div>
      </Container>
    </Section>
  </main>
  <Footer />
</BaseLayout>
