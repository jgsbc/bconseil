---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Card from '../components/Card.astro';
import CTASection from '../components/CTASection.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { withBase } from '../lib/paths';

const repères = [
  "Aurélien PICARD",
  "Conseil patrimonial",
  "Relation directe",
  "Approche confidentielle",
  "Pédagogie",
  "Accompagnement dans la durée",
  "Cabinet à taille humaine",
];
---

<BaseLayout
  title="À propos"
  metaTitle="À propos — Berlioz Conseil"
  description="Découvrez Berlioz Conseil, cabinet patrimonial à taille humaine porté par Aurélien Picard, à Collonges-au-Mont-d’Or."
>
  <Header />
  <main class="flex-grow">
    <Section class="bg-visual bg-about-a bg-visual-readable premium-gradient border-b border-bc-border min-h-[50vh] flex items-center">
      <Container class="max-w-4xl">
        <Eyebrow>Le fondateur</Eyebrow>
        <h1 class="text-3xl md:text-5xl lg:text-6xl leading-tight mb-8 font-light">
          Aurélien Picard
        </h1>
        <p class="text-xl md:text-2xl text-bc-text-secondary font-light max-w-3xl leading-relaxed">
          Berlioz Conseil est porté par Aurélien Picard. Le cabinet privilégie une relation directe, confidentielle et pédagogique, centrée sur la compréhension des décisions patrimoniales avant la mise en place de solutions.
        </p>
      </Container>
    </Section>

    <Section>
      <Container class="max-w-5xl">
        <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 items-start">
          <div class="space-y-6 text-bc-text-secondary text-lg leading-relaxed">
            <h2 class="text-bc-text-primary mb-8 text-2xl font-serif">Une vision globale du conseil</h2>
            <p>
              Une décision patrimoniale ne se limite pas à un produit ou à un support. Elle doit être replacée dans une situation familiale, professionnelle, successorale et fiscale cohérente.
            </p>
            <p>
              C'est dans cet esprit que Berlioz Conseil accompagne ses clients : avec une lecture d'ensemble, une méthode claire et un souci constant de confidentialité.
            </p>
            <p>
              Le cabinet vise un accompagnement lisible, posé et durable, adapté aux situations où les enjeux patrimoniaux comptent vraiment.
            </p>
          </div>

          <Card class="premium-card-motion">
            <div class="flex items-center gap-4 mb-8">
              <img
                src={withBase('/logo/berlioz-logo-round.webp')}
                alt="Berlioz Conseil"
                class="h-20 w-20 rounded-full"
                loading="lazy"
                decoding="async"
              />
              <div>
                <p class="text-xs uppercase tracking-[0.24em] text-bc-accent-champagne/80 mb-2">Berlioz Conseil</p>
                <p class="text-sm text-bc-text-muted mb-0">Cabinet patrimonial à taille humaine</p>
              </div>
            </div>
            <h2 class="text-bc-text-primary mb-8 text-2xl font-serif">Repères</h2>
            <ul class="space-y-4 text-bc-text-secondary text-sm md:text-base">
              {repères.map((item) => (
                <li class="flex gap-3">
                  <span class="text-bc-accent-bronze mt-1">▪</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </Card>
        </div>
      </Container>
    </Section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>
